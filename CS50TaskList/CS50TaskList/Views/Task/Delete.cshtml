@{
    ViewData["Title"] = "Delete Task";
}
@model CS50TaskList.Models.TaskModel

<h2>Delete Task</h2>

<form asp-action="Delete" asp-controller="Task" method="post">
    <input hidden value="@Model.Id" />

    <div class="mb-3">
        <div class="row mb-3">
            <div class="col-md-6 col-12">
                <label for="title" class="form-label">Title</label>
                <input asp-for="Title" type="text" class="form-control" readonly id="title" placeholder="Enter your title" value="@Model.Title">
            </div>



            @if (Model.Date == null)
            {
                <div class="col-md-4 col-8">
                    <label for="date" class="form-label">Date</label>
                    <input asp-for="Date" class="form-control" readonly id="date" type="date" />
                </div>

                <div class="col-md-2 col-4" id="time" style="display:none">
                    <label for="time" class="form-label">Time</label>
                    <input asp-for="Time" class="form-control" readonly type="time" />
                </div>
            }
            else
            {
                <div class="col-md-4 col-8">
                    <label for="date" class="form-label">Date</label>
                    <input asp-for="Date" class="form-control" readonly id="date" type="date" value="@Model.Date.Value.ToString("yyyy-MM-dd")" />
                </div>
                if (Model.Time == null)
                {
                    <div class="col-md-2 col-4" id="time">
                        <label for="time" class="form-label">Time</label>
                        <input asp-for="Time" class="form-control" readonly type="time" />
                    </div>
                }
                else
                {
                    <div class="col-md-2 col-4" id="time">
                        <label for="time" class="form-label">Time</label>
                        <input asp-for="Time" class="form-control" readonly type="time" value="@Model.Time.Value.ToString("H:mm:ss")" />
                    </div>
                }
            }
        </div>

        <div class="row mb-3">
            <div class="col-md-6">
                <label for="priority" class="form-label">Priority</label>
                <select asp-for="Priority" aria-label="Priority select" class="form-select" disabled id="priority">
                    @{
                        var priorities = new List<CS50TaskList.Enums.PriorityType> {
                    CS50TaskList.Enums.PriorityType.None,
                    CS50TaskList.Enums.PriorityType.Low,
                    CS50TaskList.Enums.PriorityType.Medium,
                    CS50TaskList.Enums.PriorityType.High
                    };

                        foreach (CS50TaskList.Enums.PriorityType priority in priorities)
                        {
                            if (Model.Priority == priority)
                            {
                                <option selected value="@priority">@priority.ToString()</option>
                            }
                            else
                            {
                                <option value="@priority">@priority.ToString()</option>
                            }
                        }
                    }
                </select>
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-12">
                <label for="notes" class="form-label">Notes</label>
                <textarea asp-for="Notes" class="form-control" readonly id="notes" type="text" value="@Model.Notes"></textarea>
            </div>
        </div>

        @if (Model.SubTasks.Any())
        {
            <div class="row mb-3">
                <div class="col">
                    <label class="form-label h4" for="addSubTask">Sub-Tasks</label>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6 col-12">
                    <ul class="list-group list-group-flush">
                        @foreach (SubTaskModel subTask in Model.SubTasks)
                        {
                            <li class="list-group-item">
                                <input hidden value="@subTask.Id" />
                                <label class="form-check-label">@subTask.Title</label>
                                <input hidden value="@subTask.ParentId" />
                            </li>
                        }
                    </ul>
                </div>
            </div>
        }
    </div>

    <button class="btn btn-danger" type="submit">Confirm Delete</button>
    <a asp-action="Index" asp-controller="Task" class="btn btn-outline-secondary">Cancel</a>
</form>