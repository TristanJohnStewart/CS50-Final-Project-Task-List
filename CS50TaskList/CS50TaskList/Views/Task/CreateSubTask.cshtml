@{
    ViewData["Title"] = "Create Sub-Task";
}
@model CS50TaskList.Models.TaskModel

<h2>Create Sub-Task</h2>

<div class="container">
    <form asp-action="CreateSubTask" asp-controller="Task" method="post">
        <div class="row">
            <div class="col">
                <div class="mb-3">
                    <label asp-for="Title" class="form-label"></label>

                    <input asp-for="Title" class="form-control" placeholder="Title" type="text">
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col">
                <button class="btn btn-primary" type="submit">Create Sub-Task</button>

                <a asp-action="Create" asp-controller="Task" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </div>
    </form>
</div>
