@{
    ViewData["Title"] = "Home Page";
}

<h2>Edit Task</h2>

<div class="container">
    <div class="row">
        <div class="col">
            <div class="mb-3">
                <label for="titleInput" class="form-label">Title</label>

                <input type="text" class="form-control" id="titleInput" placeholder="Title">
            </div>
        </div>

        <div class="w-100 d-none d-md-block"></div>

        <div class="col">
            <div class="mb-3">
                <label for="notesInput" class="form-label">Notes</label>

                <input type="text" class="form-control" id="notesInput" placeholder="Notes...">
            </div>
        </div>
    </div>

    @* <div class="row">

    </div> *@

    <div class="row">
        <div class="col">
            deadline selection here
        </div>

        <div class="col">
            <div class="mb-3">
                <label for="priorityInput" class="form-label">Priority</label>

                <select class="form-select" id="priorityInput" aria-label="Default select example">
                    <option selected>None</option>
                    <option value="1">Low</option>
                    <option value="2">Medium</option>
                    <option value="3">High</option>
                </select>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col">
            <div class="mb-3">
                <label for="repeatInput" class="form-label">Repeat</label>

                <select class="form-select" id="repeatInput" aria-label="Default select example">
                    <option selected>None</option>
                    <option value="1">Daily</option>
                    <option value="2">Weekly</option>
                    <option value="3">Monthly</option>
                    <option value="4">Yearly</option>
                </select>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col">
            <div class="mb-3">
                <label for="subTaskInput" class="form-label">Sub-Tasks</label>

                <div id="subTaskInput">
                    @* all sub-tasks are listed in order with any new sub-tasks appended onto that list *@
                    <div class="input-group mb-3">
                        <button class="btn btn-outline-secondary" type="button" id="button-addon1">-</button>
                        <input type="text" class="form-control" value="What ever the name of the sub-task is" aria-label="Example text with button addon" aria-describedby="button-addon1">
                    </div>
                    <div class="input-group mb-3">
                        <button class="btn btn-outline-secondary" type="button" id="button-addon1">+</button>
                        <input type="text" class="form-control" aria-label="Example text with button addon" aria-describedby="button-addon1">
                    </div>
                </div>

            </div>
        </div>
    </div>

    <div class="row">
        <div class="col">
            <a class="btn btn-primary" href="#">Confirm</a> @* asp-controller="Task" asp-action="EditConfirm" *@
            <a class="btn btn-secondary" asp-controller="Home" asp-action="Index">Cancel</a>
            <a class="btn btn-danger" asp-controller="Task" asp-action="Delete">Delete</a>
        </div>
    </div>
</div>

@*
    Title:
    Input Box

    Notes:
    Input Box

    Deadline:
    Calendar Selection

    Sub-Tasks:
    Add Sub-Task Button
    +--------------------------------------------------------------+
    | Sub-Task Title / Input Box | Delete Sub-Task "-" or "Delete" |
    +--------------------------------------------------------------+
    (Add sub-task button should be replaced by a new sub-task list entry with input box and delete buttons,
    then get redrawn at the bottom of the list)

    Repeat:
    Drop Down Menu with list of repeat types

    Priority:
    Drop Down Menu

    Save Button | Cancel Button
*@