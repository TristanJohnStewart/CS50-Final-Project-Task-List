@{
    ViewData["Title"] = "Edit Task";
}
@model CS50TaskList.Models.TaskModel

<h2>Edit Task</h2>

<form asp-action="Edit" asp-controller="Task" method="post">
    <input hidden value="@Model.Id" />

    <div class="mb-3">
        <div class="row mb-3">
            <div class="col-md-6 col-12">
                <label for="title" class="form-label">Title</label>
                <input asp-for="Title" type="text" class="form-control" id="title" placeholder="Enter your title" value="@Model.Title">
            </div>



            @if (Model.Date == null)
            {
                <div class="col-md-4 col-8">
                    <label for="date" class="form-label">Date</label>
                    <input asp-for="Date" class="form-control" id="date" type="date" />
                </div>

                <div class="col-md-2 col-4" id="time" style="display:none">
                    <label for="time" class="form-label">Time</label>
                    <input asp-for="Time" class="form-control" type="time" />
                </div>
            }
            else
            {
                <div class="col-md-4 col-8">
                    <label for="date" class="form-label">Date</label>
                    <input asp-for="Date" class="form-control" id="date" type="date" value="@Model.Date.Value.ToString("yyyy-MM-dd")" />
                </div>
                if (Model.Time == null)
                {
                    <div class="col-md-2 col-4" id="time">
                        <label for="time" class="form-label">Time</label>
                        <input asp-for="Time" class="form-control" type="time" />
                    </div>
                }
                else
                {
                    <div class="col-md-2 col-4" id="time">
                        <label for="time" class="form-label">Time</label>
                        <input asp-for="Time" class="form-control" type="time" value="@Model.Time.Value.ToString("H:mm:ss")" />
                    </div>
                }
            }
        </div>

        <div class="row mb-3">
            <div class="col-md-6">
                <label for="priority" class="form-label">Priority</label>
                <select asp-for="Priority" aria-label="Priority select" class="form-select" id="priority">
                    @{
                        var priorities = new List<CS50TaskList.Enums.PriorityType> {
                    CS50TaskList.Enums.PriorityType.None,
                    CS50TaskList.Enums.PriorityType.Low,
                    CS50TaskList.Enums.PriorityType.Medium,
                    CS50TaskList.Enums.PriorityType.High
                    };

                        foreach (CS50TaskList.Enums.PriorityType priority in priorities)
                        {
                            if (Model.Priority == priority)
                            {
                                <option selected value="@priority">@priority.ToString()</option>
                            }
                            else
                            {
                                <option value="@priority">@priority.ToString()</option>
                            }
                        }
                    }
                </select>
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-12">
                <label for="notes" class="form-label">Notes</label>
                <textarea asp-for="Notes" class="form-control" id="notes" type="text" value="@Model.Notes"></textarea>
            </div>
        </div>

        <div class="row mb-3">
            <div class="col d-flex align-items-center">
                <label class="form-label h4 mb-0 me-2" for="addSubTask">Sub-Tasks</label>
                <a asp-action="Create" asp-controller="Subtask" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-sm" id="addSubTask">Add Sub-Task</a>
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-lg-6 col-12">
                <ul class="list-group list-group-flush">
                    @if (!Model.SubTasks.Any())
                    {
                        <p>You don't have any subtasks.</p>
                    }
                    else
                    {
                        @foreach (SubTaskModel subTask in Model.SubTasks)
                        {
                            <li class="list-group-item d-flex align-items-center">
                                <label class="form-check-label">@subTask.Title</label>
                                <div class="ms-auto d-flex gap-2">
                                    <a asp-action="Edit" asp-controller="Subtask" asp-route-id="@subTask.Id" class="btn btn-primary btn-sm ">Edit</a>
                                    <a asp-action="Delete" asp-controller="Subtask" asp-route-id="@subTask.Id" class="btn btn-danger btn-sm">Delete</a>
                                </div>
                            </li>
                        }
                    }
                </ul>
            </div>
        </div>
    </div>

    <button class="btn btn-primary" type="submit">Confirm Edit</button>
    <a asp-action="Index" asp-controller="Task" class="btn btn-outline-secondary">Cancel</a>
    @* <a class="btn btn-outline-secondary" href="javascript:history.back()">Cancel</a> *@
    <a asp-action="Delete" asp-controller="Task" asp-route-id="@Model.Id" class="btn btn-danger">Delete</a>
</form>

<script>
    document.getElementById("date").addEventListener("change", toggleTime);

    function toggleTime() {
        var timeInput = document.getElementById("time");
        if (timeInput.style.display === 'none') {
            timeInput.style.display = 'block';
        }
        else {
            timeInput.style.display = 'none';
        }
    }
</script>