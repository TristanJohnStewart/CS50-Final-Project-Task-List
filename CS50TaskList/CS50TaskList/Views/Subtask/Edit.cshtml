@{
    ViewData["Title"] = "Edit Subtask";
}
@model CS50TaskList.Models.SubTaskModel

<h2>Edit Subtask</h2>

<div class="container">
    <form asp-action="Edit" asp-controller="Subtask" method="post">
        <input asp-for="ParentId" hidden type="number" value="@Model.ParentId" />

        <div class="row">
            <div class="col">
                <div class="mb-3">
                    <label asp-for="Title" class="form-label"></label>

                    <input asp-for="Title" class="form-control" placeholder="Title" type="text" value="@Model.Title">
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col">
                <button class="btn btn-primary" type="submit">Edit Subtask</button>

                <a asp-action="Index" asp-controller="Home" class="btn btn-outline-secondary">Cancel</a>

                <a asp-action="Delete" asp-controller="Subtask" asp-route-id="@Model.Id" class="btn btn-danger">Delete</a>
            </div>
        </div>
    </form>
</div>