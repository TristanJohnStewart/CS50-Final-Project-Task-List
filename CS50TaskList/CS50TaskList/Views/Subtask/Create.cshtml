@{
    ViewData["Title"] = "Create Subtask";
}
@model CS50TaskList.Models.SubTaskModel

<h2>Create Subtask</h2>

<div class="container">
    <form asp-action="Create" asp-controller="Subtask" method="post">
        <input asp-for="ParentId" hidden value="@Model.ParentId" />

        <div class="row">
            <div class="col-md-6">
                <div class="mb-3">
                    <label asp-for="Title" class="form-label"></label>

                    <input asp-for="Title" class="form-control" placeholder="Title" type="text">
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col">
                <button class="btn btn-primary" type="submit">Create Subtask</button>

                <a asp-action="Edit" asp-controller="Task" asp-route-id="@Model.ParentId" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </div>
    </form>
</div>


