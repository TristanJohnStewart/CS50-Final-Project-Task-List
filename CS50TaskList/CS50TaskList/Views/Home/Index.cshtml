@{
    ViewData["Title"] = "Home Page";
}

@*  
    +--------------------------------------------------+
    | Create Task "+" | Sort (drop down menu)          |
    +--------------------------------------------------+
    +--------------------------------------------------+
    | Drag Point | Check Box | Title     | Edit        |
    |            |           | Priority  | Deadline    |
    |            |           | Notes                   |
    |            |+-----------------------------------+|
    |            || Check Box | Sub-Task Title        ||
    |            |+-----------------------------------+|
    +--------------------------------------------------+
*@

<style>
table, th, td {
  border: 1px solid black;
  border-collapse: collapse;
}
</style>

<div>
    <table>
        <tr>
            <th>Create Task</th>
            <th>Sort</th>

        </tr>
        <tr>
            <td colspan="2"><table>
                <tr>
                    <td rowspan="4">Drag Point</td>
                    <td rowspan="3">Check Box</td>
                    <td>Title</td>
                    <td>Edit Button</td>

                </tr>
                <tr>
                    <td>Priority Type</td>
                    <td>Deadline</td>
                </tr>
                <tr>
                    <td colspan="2">Notes</td>
                </tr>
                <tr>
                    <td colspan="3"><table>
                        <tr>
                            <td>Check Box</td>
                            <td>Sub-Task Title</td>

                        </tr>

                    </table></td>

                </tr>

            </table></td>

        </tr>

    </table>

</div>