@{
    ViewData["Title"] = "Home Page";
}
@model List<CS50TaskList.Models.TaskModel>

<section class="hero">
    <div class="container">
        <h1>Hello, CS50!</h1>

        <p class="lead mb-4">
            Welcome to my Final Project for <strong>HarvardX's CS50</strong> — an intuitive To-Do List web app designed to help you stay organized and on top of your daily tasks.
        </p>

        <p>To begin, click the register or login buttons in the top right to create an 'account' begin organising your chores and tasks!</p>

        <!-- About Section -->
        <h2 class="fw-bold mb-3">About This Project</h2>

        <p class="mb-5">
            This project was created as part of HarvardX's <em>CS50's Introduction to Computer Science</em> course. The goal was to develop a functional piece of software using any languages or frameworks of our choice.
            Built using modern web technologies and hosted as if it were deployed to the cloud with services like <strong>Azure</strong> or <strong>AWS</strong>.
            The app simulates a realistic user experience — from registration and login to managing personal to-do items — all while demonstrating concepts like authentication, CRUD operations, and responsive UI design.
        </p>

        <p class="fst-italic text-secondary"> Please note: this demo is for educational purposes only — no real data is stored or transmitted. </p>
    </div>
</section>

